+def test_cli_env_drops_credentials_and_remote_daemon(monkeypatch):
+    for key in ('API_KEY', 'DOCKER_HOST', 'DOCKER_CONTEXT', 'DOCKER_CONFIG', 'HOME', 'HTTP_PROXY'):

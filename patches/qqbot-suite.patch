+MAX_FILES = 256
+MAX_FILE_BYTES = 32 * 1024 * 1024
+MAX_TOTAL_BYTES = 128 * 1024 * 1024
+MAX_STREAM_BYTES = 64 * 1024
+MAX_COMMAND_BYTES = 32 * 1024
+MAX_WIRE_BYTES = 180 * 1024 * 1024

+def test_popen_no_shell_and_bounded_capture(monkeypatch):
+    class Process:
+        def __init__(self):
+            self.stdin = io.BytesIO()
+            self.stdout = io.BytesIO(b"x" * (sandbox.MAX_WIRE_BYTES + 1))

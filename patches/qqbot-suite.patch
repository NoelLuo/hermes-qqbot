+        kind = action["kind"]
+        if kind == "click_link" and (type(action["index"]) is not int or not 0 <= action["index"] < 80):
+            raise ValueError("Invalid link index")
+        if kind == "scroll" and (type(action["pixels"]) is not int or not -2000 <= action["pixels"] <= 2000):

+        'guest-workspace': {'office_image': 'sha256:' + 'a' * 64}}}}), encoding='utf-8')
+    policy = RequestSecurityPolicy('visitor', 'qqbot', 'group')
+    base = tmp_path / 'storage'
+    seen = []
+    reply = {'success': True, 'stdout': '', 'stderr': '', 'errors': [], 'files': {}}

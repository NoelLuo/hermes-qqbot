+              "scroll": {"kind", "pixels"}, "screenshot": {"kind"},
+              "download": {"kind", "url", "name"}}
+    for action in actions:
+        if not isinstance(action, dict) or action.get("kind") not in fields or set(action) != fields[action["kind"]]:

+
+
+def test_ipv6_only_refused_without_socket(transport, monkeypatch):
+    monkeypatch.setattr(net.socket, "getaddrinfo", lambda *args: [record("2606:4700:4700::1111")])
+    with pytest.raises(net.PublicNetworkError, match="IPv4"):

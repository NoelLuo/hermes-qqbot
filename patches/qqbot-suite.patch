+            or re.match(r'^(con|prn|aux|nul|com[0-9¹²³]|lpt[0-9¹²³])(?:\.|$)',part,re.I)
+            or any(ord(c)<32 or c in '\\:<>"|?*' for c in part)):
+            raise ValueError('Unsafe output path')

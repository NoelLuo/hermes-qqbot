+@pytest.mark.asyncio
+async def test_durable_quiet_busy_replay_and_single_trigger(rig, monkeypatch):
+    adapter, store = rig
+    judge = AsyncMock(return_value=False)
+    monkeypatch.setattr(adapter._group_reply_gate, "_judge", judge)

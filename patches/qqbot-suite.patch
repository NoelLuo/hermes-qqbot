+            or name.endswith((".", " ")) or name.rsplit(".", 1)[-1].lower() not in EXTENSIONS
+            or re.match(r"^(con|prn|aux|nul|com[0-9]|lpt[0-9])(?:\.|$)", name, re.IGNORECASE)):
